# ---------------------------------------------------------------
# WordPress .gitignore
# Ignores core files, config and uploads.
# Tracks only your own themes, plugins and mu-plugins.
# ---------------------------------------------------------------

# Config and secrets
wp-config.php
wp-config-sample.php
wp-config-local.php
*.env
.env
.env.*
auth.json
.htpasswd

# WordPress core directories
/wp-admin/
/wp-includes/

# WordPress root files
/index.php
/license.txt
/readme.html
/wp-activate.php
/wp-blog-header.php
/wp-comments-post.php
/wp-cron.php
/wp-links-opml.php
/wp-load.php
/wp-login.php
/wp-mail.php
/wp-settings.php
/wp-signup.php
/wp-trackback.php
/xmlrpc.php
/.htaccess
/web.config
/robots.txt
/sitemap.xml
/sitemap.xml.gz

# wp-content: ignore everything, then allow your own code back in
/wp-content/*
!/wp-content/themes/
!/wp-content/plugins/
!/wp-content/mu-plugins/

# Default themes and bundled plugins
/wp-content/themes/twenty*/
/wp-content/plugins/akismet/
/wp-content/plugins/hello.php
/wp-content/plugins/index.php
/wp-content/themes/index.php

# Uploads, cache, upgrade and backups
/wp-content/uploads/
/wp-content/blogs.dir/
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/
/wp-content/backup-db/
/wp-content/backups/
/wp-content/cache/
/wp-content/advanced-cache.php
/wp-content/object-cache.php
/wp-content/db.php
/wp-content/debug.log
/wp-content/uploads.ini

# Database dumps
*.sql
*.sql.gz
*.sqlite

# Logs
*.log
error_log
debug.log
/logs/

# Dependency folders
node_modules/
vendor/
bower_components/

# Build tools and lock files you may not want tracked
.sass-cache/
*.css.map
*.js.map

# Editor and OS files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Archives and temp
*.zip
*.tar
*.tar.gz
*.rar
*.bak
*.tmp